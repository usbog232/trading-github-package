{
  "mode": "manual_confirm",
  "exchange": "hyperliquid",
  "symbols": ["BTC", "ETH", "HYPE"],
  "timeframes": ["15m", "1h"],
  "account": {
    "base_equity": 200,
    "quote_currency": "USDE"
  },
  "risk": {
    "risk_per_trade_pct": 3.0,
    "max_risk_per_trade_pct": 8.0,
    "max_daily_drawdown_pct": 8.0,
    "max_consecutive_losses": 3,
    "max_open_positions": 4,
    "macd_reserved_slots": 1,
    "allow_scale_in": false,
    "require_stop_loss": true
  },
  "execution": {
    "default_position_size": "light",
    "slippage_limit_pct": 0.3,
    "auto_execute": false,
    "enable_live_execution": false,
    "enable_auto_test_entries": false,
    "enable_auto_live_entries": false,
    "auto_test_leverage": 5,
    "auto_live_leverage_min": 5,
    "auto_live_leverage_max": 8,
    "auto_entry_leverage": 5,
    "auto_live_order_usdc": 25,
    "test_order_mode": false,
    "test_order_max_usdc": 15,
    "test_order_max_loss_pct": 1.0,
    "test_order_daily_max_loss_usdc": 5.0,
    "cancel_stale_orders": true
  },
  "analysis": {
    "indicators": ["RSI", "MACD", "ATR", "VOLUME"],
    "require_multi_timeframe_alignment": true,
    "min_signal_score": 70,
    "min_auto_rr": 2.0
  },
  "macd_divergence": {
    "enabled": true,
    "pivot_window": 3,
    "max_age_bars": 20,
    "entry_zone_buffer_pct": 0.0015
  },
  "api": {
    "base_url": "https://api.hyperliquid.xyz",
    "use_websocket": true,
    "monitor_wallet_address": "",
    "execution_wallet_address": "",
    "secret_key_env": "HYPERLIQUID_SECRET_KEY"
  }
}
